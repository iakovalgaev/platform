{
	"$schema": "https://json.schemastore.org/tsconfig",
	"extends": "./base.json",
	"compilerOptions": {
		"rootDir": "${configDir}/src",
		"outDir": "${configDir}/dist",
		/** Emit types for internal packages to speed up editor performance. */
		"declaration": true,
		"declarationMap": true,
		"emitDeclarationOnly": true,
		"composite": true,
		"noEmit": false
	}
}
