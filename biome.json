{
	"files": {
		"includes": ["**"]
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on",
				"useSortedAttributes": "on",
				"useSortedProperties": "on"
			}
		}
	},
	"json": {
		"parser": {
			"allowComments": true,
			"allowTrailingCommas": true
		}
	},
	"linter": {
		"rules": {
			"correctness": {
				"useExhaustiveDependencies": "error"
			},
			"suspicious": {
				"noConsole": {
					"level": "warn",
					"options": { "allow": ["error", "warn", "info"] }
				}
			}
		}
	},
	"overrides": [
		{
			"includes": [
				"tooling/scripts/**",
				"tooling/cli-kit/**",
				"packages/**/scripts/**"
			],
			"linter": {
				"rules": {
					"suspicious": {
						"noConsole": "off"
					}
				}
			}
		}
	]
}
