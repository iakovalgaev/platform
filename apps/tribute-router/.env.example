NODE_ENV=development
PORT=8000

# Ключ API аккаунта Tribute, тот же у всех проектов: им подписаны вебхуки.
TRIBUTE_API_KEY=

# JSON-массив проектов и их товаров Tribute. Имена и product id не повторяются.
# url — эндпоинт проекта, который сам проверяет подпись trbt-signature.
TRIBUTE_ROUTES=[{"name":"dubmate","url":"https://dubmate.example.com/api/webhooks/tribute","productIds":["1"]}]

LOG_LEVEL=debug
LOKI_URL=
