{
	"name": "@acme/kit",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./src/index.ts"
		},
		"./time": {
			"types": "./dist/time/index.d.ts",
			"default": "./src/time/index.ts"
		},
		"./env": {
			"types": "./dist/env/index.d.ts",
			"default": "./src/env/index.ts"
		},
		"./node": {
			"types": "./dist/node/index.d.ts",
			"default": "./src/node/index.ts"
		},
		"./logger": {
			"types": "./dist/logger/index.d.ts",
			"default": "./src/logger/index.ts"
		}
	},
	"license": "MIT",
	"scripts": {
		"build:types": "tsc",
		"clean": "git clean -xdf .cache .turbo dist node_modules",
		"dev": "tsc",
		"check": "biome check ./src",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"dayjs": "^1.11.18",
		"es-toolkit": "catalog:",
		"pino": "catalog:pino",
		"pino-loki": "catalog:pino",
		"pino-pretty": "catalog:pino",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@acme/tsconfig": "workspace:*",
		"@biomejs/biome": "catalog:",
		"@types/node": "catalog:",
		"typescript": "catalog:"
	}
}
